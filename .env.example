# Requerida — API key de Google AI Studio (https://aistudio.google.com/app/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Opcionales — persistencia de estado de dispositivos en Vercel KV / Upstash
# for Redis (integración desde el Marketplace de Vercel). Sin estas dos
# variables, el proyecto usa un archivo JSON local en desarrollo
# (.data/device-state.json, gitignored) y memoria del proceso en producción.
# Ver lib/devices/README.md para el trade-off completo.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
